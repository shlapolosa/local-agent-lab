{
  "type": "object",
  "properties": {
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "description": "The capability this component provides, written as the map's own key — \"Domain · Capability\", copied character for character from the coverage map's `capability_id`. NOT the bare label: the key is what joins this selection to the capability step 5 matched, and a label joins to nothing."
          },
          "component_id": {
            "type": "string",
            "minLength": 3,
            "description": "The catalogue id of the component (the `id` column of the component catalogue in your context). Only a catalogue component may be selected (G04)."
          },
          "component": {
            "type": "string"
          },
          "rejected_alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "capability",
          "component_id",
          "component"
        ],
        "additionalProperties": false
      }
    },
    "building_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        },
        "required": [
          "what",
          "owner"
        ],
        "additionalProperties": false
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conflict": {
            "type": "string"
          },
          "sacrificed": {
            "type": "string"
          },
          "compensating_control": {
            "type": "string"
          },
          "review_trigger": {
            "type": "string"
          }
        },
        "required": [
          "conflict",
          "sacrificed",
          "compensating_control",
          "review_trigger"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "selected",
    "tradeoffs",
    "unresolved"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "component_selection"
}
