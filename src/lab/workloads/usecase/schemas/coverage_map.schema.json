{
  "type": "object",
  "properties": {
    "matched": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "function": {
            "type": "string"
          },
          "capability_id": {
            "type": "string"
          },
          "capability_label": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "lookup",
              "assumption",
              "survey"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "description": "Which level of the capability map this match was made at. Written by the drill, not by the agent \u2014 a pass matches at the level it was given."
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The capability path this function resolved through, L1 first. Written by the drill: it is how the match was reached, not something an agent asserts."
          }
        },
        "required": [
          "function",
          "capability_id",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "functions_without_capability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities_without_function": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gap_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string"
          },
          "owning_body": {
            "type": "string"
          }
        },
        "required": [
          "what"
        ],
        "additionalProperties": false
      }
    },
    "heat_map": {
      "type": "object",
      "properties": {
        "commodity": {
          "type": "boolean"
        },
        "mature": {
          "type": "boolean"
        },
        "meets_target": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "description": "Where the position was read from. A heat-map position is a LOOKUP against the published capability map, not a judgement."
        }
      },
      "required": [
        "commodity",
        "mature",
        "meets_target",
        "source"
      ],
      "additionalProperties": false,
      "description": "Where the matched capability sits on the capability heat map. Step 16's reject rule reads it: a capability that is commodity, mature and already meeting target is a reason NOT to build."
    }
  },
  "required": [
    "capabilities_without_function",
    "functions_without_capability",
    "matched"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage_map"
}
