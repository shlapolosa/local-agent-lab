{
  "type": "object",
  "properties": {
    "resources": {
      "type": "array",
      "items": {"type": "string", "minLength": 2},
      "description": "Price-sheet service names, spelled EXACTLY as the sheet spells them."
    },
    "switched_on_by": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "resource -> the family or component that requires it."
    },
    "envelope": {"enum": ["low", "expected", "high"]},
    "build_amount": {"type": "number", "minimum": 0},
    "build_provenance": {"enum": ["vendor quote", "budget bucket", "estimate", ""]},
    "build_basis": {"type": "string"},
    "unpriceable": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Anything the design needs that the sheet has no line for. A gap flag, never a substitution."
    }
  },
  "required": ["resources", "switched_on_by", "envelope", "unpriceable"],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cost_inputs"
}
