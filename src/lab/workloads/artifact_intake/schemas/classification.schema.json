{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fabric classification \u2014 what the classifier agent suggests about one artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "confidence",
    "subjects",
    "subject_confidence",
    "rationale"
  ],
  "properties": {
    "document_type": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^urn:fabric:scheme:doc-types#[a-z0-9-]+$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "subjects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    },
    "rationale": {
      "type": "string",
      "maxLength": 400
    },
    "subject_confidence": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "How sure you are of EACH subject, keyed by the id you returned. One can be certain while another is a guess, which a single confidence for the whole classification cannot say. Anything below the deployment's floor never becomes a link."
    }
  }
}
