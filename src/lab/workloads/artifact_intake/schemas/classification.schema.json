{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fabric classification — what the classifier agent suggests about one artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "confidence", "subjects", "rationale"],
  "properties": {
    "document_type": {"type": ["string", "null"], "pattern": "^urn:fabric:scheme:doc-types#[a-z0-9-]+$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "subjects": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 80}},
    "rationale": {"type": "string", "maxLength": 400}
  }
}
