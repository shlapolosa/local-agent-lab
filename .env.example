# copy to .env and fill in — .env is git-ignored
OLLAMA_API_KEY=
ADOIT_USERNAME=
ADOIT_PASSWORD=''
ADOIT_BASE_URL=https://adoit-ce.boc-cloud.com
ADOIT_REPO_ID=
LITELLM_MASTER_KEY=sk-change-me
DATABASE_URL='postgresql://user:pass@host/litellm?sslmode=require'
NEON_API_KEY=
NEON_PROJECT_ID=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SERVICE_NAME=litellm-gateway
EA_AGENT_KEY=            # from gateway/bootstrap_registry.py
ARCHIMATE_SKILL_ID=      # from gateway/register_skill.sh
# TELEGRAM_BOT_TOKEN= / TELEGRAM_CHAT_ID=   enable the Telegram approval channel

# --- cloud-shape settings ---
MCP_SHARED_SECRET=            # gateway -> MCP servers bearer token (required whenever BIND_HOST != 127.0.0.1)
ARTIFACTS_URL=$DATABASE_URL   # art:// store: postgres://… (any host) or file:///dir (single machine)
# BIND_HOST=0.0.0.0
# GATEWAY_URL= ADOIT_MCP_URL= SEMANTIC_MCP_URL= REVIEW_APP_URL= JAEGER_UI_URL= REVIEW_APP_PASSWORD=
# --- tracing backend (Jaeger on Railway, or local) ---
JAEGER_UI_URL=http://127.0.0.1:16686          # e.g. https://<service>.up.railway.app
# OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_ENDPOINT above: point at the Railway TCP proxy (http://<host>:<port>) for remote Jaeger
RAILWAY_TOKEN=                # project token (Project-Access-Token header; API also needs a browser User-Agent)
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
LITELLM_MCP_CLIENT_TIMEOUT=300   # MCP tool-call timeout; default 60s is too short for big renders (1,666-element maps)

GATEWAY_URL=http://127.0.0.1:4000   # gateway base URL clients use; becomes the cloud host / APIM endpoint on deploy
