# copy to .env and fill in — .env is git-ignored
OLLAMA_API_KEY=
ADOIT_USERNAME=
ADOIT_PASSWORD=''
ADOIT_BASE_URL=https://adoit-ce.boc-cloud.com
ADOIT_REPO_ID=
LITELLM_MASTER_KEY=sk-change-me
DATABASE_URL='postgresql://user:pass@host/litellm?sslmode=require'
NEON_API_KEY=
NEON_PROJECT_ID=
# Redis: LOCAL by default (Homebrew redis). For managed/cloud, set REDIS_URL (+HOST/PORT/PASSWORD)
# to the cloud instance — lab.sh then checks it instead of starting local brew redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
# Tracing: LOCAL by default (native var/tools/jaeger binary, started by lab.sh). For remote (Railway,
# App Insights) point these at the remote OTLP endpoint + set JAEGER_UI_URL; lab.sh then skips
# the local binary (and manages the Railway deployment if RAILWAY_* are set).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SERVICE_NAME=litellm-gateway
JAEGER_UI_URL=http://127.0.0.1:16686
EA_AGENT_KEY=            # from scripts/bootstrap_registry.py
ARCHIMATE_SKILL_ID=      # from scripts/register_skill.sh
# TELEGRAM_BOT_TOKEN= / TELEGRAM_CHAT_ID=   enable the Telegram approval channel
# TEAMS_WEBHOOK_URL=                        enable the Microsoft Teams approval channel (incoming
#                                           webhook of the reviewers' channel); unset = channel disabled

# --- cloud-shape settings ---
MCP_SHARED_SECRET=            # gateway -> MCP servers bearer token (required whenever BIND_HOST != 127.0.0.1)
ARTIFACTS_URL=$DATABASE_URL   # art:// store: postgres://… (any host) or file:///dir (single machine)
# BIND_HOST=0.0.0.0
# GATEWAY_URL= ADOIT_MCP_URL= SEMANTIC_MCP_URL= REVIEW_APP_URL= JAEGER_UI_URL= REVIEW_APP_PASSWORD=
# --- tracing backend (Jaeger on Railway, or local) ---
JAEGER_UI_URL=http://127.0.0.1:16686          # e.g. https://<service>.up.railway.app
# OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_ENDPOINT above: point at the Railway TCP proxy (http://<host>:<port>) for remote Jaeger
RAILWAY_TOKEN=                # project token (Project-Access-Token header; API also needs a browser User-Agent)
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
LITELLM_MCP_CLIENT_TIMEOUT=300   # MCP tool-call timeout; default 60s is too short for big renders (1,666-element maps)

GATEWAY_URL=http://127.0.0.1:4000   # gateway base URL clients use; becomes the cloud host / APIM endpoint on deploy

# --- submitted inputs: upload store + governed read-only storage-mcp (port 9300) ---
# STORAGE_MCP_URL=http://127.0.0.1:9300/mcp   # as seen by the gateway (Railway: http://storage-mcp.railway.internal:9300/mcp)
# UPLOADS_URL=s3://<bucket>/uploads           # where the review app stores uploads; unset = same store as ARTIFACTS_URL (no S3 needed locally)
# S3_ENDPOINT= S3_REGION= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_URL_STYLE=path
#   ^ bucket credentials — held ONLY by the review app (writes) and storage-mcp (reads); never by a workload.
#     Railway: `python deploy/railway.py bucket up` creates the bucket and writes these as # CLOUD: lines.

# --- collaboration (files + meetings): the vendor-neutral collab_mcp port, served by graph-mcp ---
# GRAPH_MCP_URL=http://127.0.0.1:9500/mcp   # as the gateway sees it (config/litellm-config.yaml collab_mcp)
# GRAPH_MCP_PORT=9500
# COLLAB_PROVIDER=graph         # which adapter the substrate wires (lab.substrate.container.COLLAB_PROVIDERS)

# --- collaboration provider (Microsoft Graph adapter; app-only, own Entra app registration) ---
# One more app registration in the SAME tenant as the agents (ENTRA_TENANT_ID), differing only in
# what it is granted: Microsoft Graph APPLICATION permissions. Least privilege per capability —
# Sites.Selected/Sites.Read.All (sites), Files.Read.All (drives/items/content), Calendars.Read or
# OnlineMeetings.Read.All (meetings), OnlineMeetingRecording.Read.All, OnlineMeetingTranscript.Read.All.
# Recordings/transcripts ALSO need the Teams application access policy (PowerShell only:
# New-CsApplicationAccessPolicy + Grant-CsApplicationAccessPolicy, ~30 min to propagate) — that
# missing policy, not the grant, is the usual cause of a confusing 403.
# GRAPH_AUTH_MODE=app           # app (client credentials) | static (GRAPH_ACCESS_TOKEN) | none
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=          # a long-lived SECRET minting short-lived tokens; a certificate is better
# GRAPH_ACCESS_TOKEN=           # mode=static only: `az account get-access-token --resource https://graph.microsoft.com`
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# GRAPH_MEETING_USER=           # whose calendar/meetings app-only reads default to (Graph reads per user)
# GRAPH_MEETING_USERS=          # comma-separated: every mailbox that may be read; unset = the one above only
# GRAPH_MAX_FETCH_BYTES=        # default 2 GiB — the ceiling on one fetched artifact (a recording)
# GRAPH_NOTIFICATION_ALLOWLIST= # comma-separated https prefixes a subscription may notify; EMPTY REFUSES ALL
# GRAPH_ALLOW_METERED=false     # gates the tenant-wide BETA meeting feeds (getAllRecordings/getAllTranscripts);
#   ^ note: since 25 Aug 2025 the Teams Graph APIs are no longer metered and `model=A|B` is ignored,
#     so the per-meeting path this adapter uses needs no Azure billing configuration at all.
