{
  "title": "CAFÉ M5 — Use Case Desk + use_case_screening · AS-BUILT (production, 4 Oct 2026)",
  "use_case": "docs/workloads/use-case-desk-integration.md",
  "base_archetype": "A2",
  "include_comps": ["c_apim", "c_entra", "c_kv", "c_pa", "c_appin", "c_cost"],
  "custom_comps": [
    {"cid": "c_teams", "zone": "z_exp", "title": "Microsoft Teams", "desc": "chat · Approvals channel", "kind": "boundary",
     "rationale": "Microsoft-run. Reaches Copilot Studio over Microsoft's own Teams channel, never through our APIM."},
    {"cid": "c_cps_ext", "zone": "z_exp", "title": "Copilot Studio engine", "desc": "Use Case Desk (Prod) · MS models", "kind": "boundary",
     "rationale": "Microsoft SaaS in the Default env (UAE). Its orchestration calls Microsoft-hosted models, not Foundry/APIM. A CLIENT of our gateway, outside the trust boundary."},
    {"cid": "c_hub", "zone": "z_exp", "title": "Power Platform API hub", "desc": "connector · connection (APIM key)", "kind": "boundary",
     "rationale": "Holds the connection; injects the usecase-submitter subscription key as api-key on every MCP call."},
    {"cid": "c_review", "zone": "z_exp", "title": "Review app", "desc": "upload · approvals · in-process", "kind": "boundary",
     "rationale": "A substrate service: writes the artifact store and publishes workflow:requests directly. Does NOT go through APIM."},
    {"cid": "c_frontdoor", "zone": "z_cog", "title": "workflow-mcp (front door)", "desc": "submit · status · approvals · ProcessSpec", "kind": "boundary"},
    {"cid": "c_wf_screen", "zone": "z_cog", "title": "wf-usecase-screening", "desc": "Agent Framework workflow · ~7 min", "kind": "boundary"},
    {"cid": "c_wf_chain", "zone": "z_cog", "title": "design · investment · provisioning", "desc": "continuation workloads", "kind": "boundary"},
    {"cid": "c_cont", "zone": "z_cog", "title": "continuations", "desc": "approval → next run (idempotent)", "kind": "boundary"},
    {"cid": "c_corpus", "zone": "z_knw", "title": "Reference corpus", "desc": "Postgres ref_* · signed · pinned", "kind": "boundary",
     "rationale": "intake-field-specs, component-prices, capability maps. No AI Search; prod reads maps whole."},
    {"cid": "c_foundry_mod", "zone": "z_mod", "title": "Foundry (UAE North)", "desc": "gpt-5-mini GlobalStandard · embed in-region", "kind": "boundary"},
    {"cid": "c_storage", "zone": "z_too", "title": "storage-mcp", "desc": "read art:// (read-only)", "kind": "boundary"},
    {"cid": "c_semantic", "zone": "z_too", "title": "semantic-mcp", "desc": "store_spec · ontologies · cafe", "kind": "boundary"},
    {"cid": "c_reference", "zone": "z_too", "title": "reference-mcp", "desc": "pin · lookup · fields", "kind": "boundary"},
    {"cid": "c_decision", "zone": "z_too", "title": "decision · valuation MCP", "desc": "feasibility · readiness · cost join", "kind": "boundary"},
    {"cid": "c_notify", "zone": "z_too", "title": "teams channel · usecase-notifier", "desc": "stream consumers → webhooks", "kind": "boundary"},
    {"cid": "c_redis", "zone": "z_data", "title": "Redis Streams", "desc": "requests · approvals · decisions", "kind": "boundary"},
    {"cid": "c_artifacts", "zone": "z_data", "title": "Artifact store", "desc": "Postgres lab_artifacts · art://", "kind": "boundary"},
    {"cid": "c_otel", "zone": "z_obs", "title": "OTel collector", "desc": "→ App Insights (4 apps: DNS fails)", "kind": "boundary"},
    {"cid": "c_aca", "zone": "z_plat", "title": "Container Apps (cae-lab-prod)", "desc": "29 apps · UAE North · floors min=1", "kind": "boundary"}
  ],
  "edges": [
    {"from": "c_teams",     "to": "c_cps_ext",     "kind": "request"},
    {"from": "c_cps_ext",   "to": "c_hub",         "kind": "request"},
    {"from": "c_hub",       "to": "c_apim",        "kind": "request"},
    {"from": "c_apim",      "to": "c_frontdoor",   "kind": "tool"},
    {"from": "c_kv",        "to": "c_apim",        "kind": "identity"},
    {"from": "c_review",    "to": "c_artifacts",   "kind": "data"},
    {"from": "c_review",    "to": "c_redis",       "kind": "event"},
    {"from": "c_frontdoor", "to": "c_redis",       "kind": "event"},
    {"from": "c_redis",     "to": "c_wf_screen",   "kind": "event"},
    {"from": "c_redis",     "to": "c_cont",        "kind": "event"},
    {"from": "c_cont",      "to": "c_redis",       "kind": "event"},
    {"from": "c_redis",     "to": "c_wf_chain",    "kind": "event"},
    {"from": "c_redis",     "to": "c_notify",      "kind": "event"},
    {"from": "c_notify",    "to": "c_pa",          "kind": "event"},
    {"from": "c_pa",        "to": "c_teams",       "kind": "event"},
    {"from": "c_wf_screen", "to": "c_apim",        "kind": "request"},
    {"from": "c_wf_chain",  "to": "c_apim",        "kind": "request"},
    {"from": "c_apim",      "to": "c_foundry_mod", "kind": "request"},
    {"from": "c_apim",      "to": "c_storage",     "kind": "tool"},
    {"from": "c_apim",      "to": "c_semantic",    "kind": "tool"},
    {"from": "c_apim",      "to": "c_reference",   "kind": "tool"},
    {"from": "c_apim",      "to": "c_decision",    "kind": "tool"},
    {"from": "c_storage",   "to": "c_artifacts",   "kind": "data"},
    {"from": "c_semantic",  "to": "c_artifacts",   "kind": "data"},
    {"from": "c_reference", "to": "c_corpus",      "kind": "knowledge"},
    {"from": "c_decision",  "to": "c_reference",   "kind": "knowledge"},
    {"from": "c_wf_screen", "to": "c_otel",        "kind": "observe"},
    {"from": "c_frontdoor", "to": "c_otel",        "kind": "observe"},
    {"from": "c_otel",      "to": "c_appin",       "kind": "observe"},
    {"from": "c_apim",      "to": "c_cost",        "kind": "observe"}
  ],
  "guardrails_enforced": ["G02", "G04", "G09", "G14"],
  "decision_points": [
    "Teams → Copilot Studio is Microsoft's channel; APIM governs only what Copilot Studio CALLS (tool path).",
    "Copilot Studio's orchestration models are Microsoft-hosted and outside APIM policy (PII masking, token limits).",
    "Every human gate ends a run; continuations starts the next one from approvals:decisions.",
    "Review app writes the store and the streams directly — the one human surface not mediated by APIM.",
    "decision/valuation read reference-mcp directly (substrate→substrate, the stated egress exception)."
  ]
}
