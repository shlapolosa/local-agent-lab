diff --git a/tests/unit/core/archimate/test_change_views.py b/tests/unit/core/archimate/test_change_views.py
new file mode 100644
index 0000000..c7364a4
--- /dev/null
+++ b/tests/unit/core/archimate/test_change_views.py
@@ -0,0 +1,103 @@
+"""Change-aware views — what an EA reads impact from: the model as it is, the model as it will be, and
+every view coloured by what changes (new / updated / consumed / removed).
+
+`changes` travels BESIDE the spec, never in it: the spec schema is a contract other channels vendor
+(1.0.0), and a change status is about one proposal, not about the architecture.
+"""
+import pytest
+
+from lab.core.archimate import engine
+from lab.core.archimate.engine import CHANGE_FILL, CHANGES, from_spec
+
+SPEC = {"name": "Impact", "id": "impact", "standard_views": True, "elements": [
+    {"id": "actor", "type": "BusinessActor", "name": "Pharmacist"},
+    {"id": "proc", "type": "BusinessProcess", "name": "Dispense"},
+    {"id": "old-app", "type": "ApplicationComponent", "name": "Legacy dispensing"},
+    {"id": "new-app", "type": "ApplicationComponent", "name": "eRx hub"},
+    {"id": "svc", "type": "ApplicationService", "name": "Prescription lookup"},
+], "relations": [
+    {"type": "Assignment", "src": "actor", "tgt": "proc"},
+    {"type": "Serving", "src": "svc", "tgt": "proc"},
+    {"type": "Realization", "src": "old-app", "tgt": "svc"},
+    {"type": "Realization", "src": "new-app", "tgt": "svc"},
+]}
+CHANGES_MAP = {"actor": "consumed", "proc": "updated", "old-app": "removed", "new-app": "new",
+               "svc": "consumed"}
+
+
+def _views(m):
+    return {v.vid: v for v in m.views}
+
+
+def test_without_changes_nothing_new_is_drawn():
+    m = from_spec(SPEC)
+    assert "as-is" not in _views(m) and "to-be" not in _views(m)
+
+
+def test_as_is_holds_what_exists_today_and_to_be_what_will():
+    m = from_spec(SPEC, changes=CHANGES_MAP)
+    v = _views(m)
+    assert set(v["as-is"].nodes) == {"actor", "proc", "old-app", "svc"}       # no NEW element
+    assert set(v["to-be"].nodes) == {"actor", "proc", "new-app", "svc"}       # no REMOVED element
+    assert all(s in v["to-be"].nodes and t in v["to-be"].nodes for _, s, t in v["to-be"].edges)
+    order = [x.vid for x in m.views]
+    assert "full" in order and order.index("full") < order.index("as-is") < order.index("to-be")
+
+
+def test_every_view_is_coloured_by_change_and_the_svg_carries_a_legend():
+    m = from_spec(SPEC, changes=CHANGES_MAP)
+    full = _views(m)["full"]
+    full.render()
+    svg = full.to_svg()
+    for status in CHANGES:
+        assert CHANGE_FILL[status] in svg
+        assert status.capitalize() in svg                                      # the legend names it
+    xml, _, _ = full.render()
+    r, g, b = engine._rgb(CHANGE_FILL["new"])
+    assert f'<fillColor r="{r}" g="{g}" b="{b}"/>' in xml                       # ADOIT/Archi see it too
+
+
+def test_a_removed_element_is_drawn_distinctly():
+    m = from_spec(SPEC, changes=CHANGES_MAP)
+    assert 'stroke-dasharray' in _views(m)["as-is"].to_svg()
+
+
+def test_an_unchanged_model_renders_byte_identically():
+    """No `changes`, no difference: the goldens other channels port against must not move."""
+    a, b = from_spec(SPEC), from_spec(SPEC, changes=None)
+    assert [v.render()[0] for v in a.views] == [v.render()[0] for v in b.views]
+    assert [v.to_svg() for v in a.views] == [v.to_svg() for v in b.views]
+
+
+def test_an_unknown_element_or_status_is_refused_by_name():
+    with pytest.raises(ValueError, match="ghost"):
+        from_spec(SPEC, changes={"ghost": "new"})
+    with pytest.raises(ValueError, match="reused"):
+        from_spec(SPEC, changes={"actor": "reused"})       # the old word is not the vocabulary
+
+
+def test_an_element_with_no_status_is_treated_as_consumed():
+    """A partial map is allowed: what the proposal does not touch exists today and still will."""
+    m = from_spec(SPEC, changes={"new-app": "new", "old-app": "removed"})
+    v = _views(m)
+    assert "actor" in v["as-is"].nodes and "actor" in v["to-be"].nodes
+
+
+def test_one_scale_with_the_capability_heatmaps():
+    """The element views and the CAFÉ heatmaps read the same colour as the same thing."""
+    from lab.core.archimate import impact
+    from lab.core.usecase.views import common
+    for status in ("new", "consumed", "missing"):
+        assert common.FILL[status] == impact.FILL[status]
+    assert CHANGE_FILL["new"] == common.FILL["new"]
+    assert CHANGE_FILL["consumed"] == common.FILL["consumed"]
+    assert CHANGE_FILL["updated"] != CHANGE_FILL["consumed"]          # a shade tells them apart
+
+
+def test_the_shared_vocabulary_is_pinned_EXACTLY_including_its_order():
+    """A deliberate parity exception to "assert membership, not exact sets": `lab.core.archimate.CHANGES`
+    is a SHARED CONTRACT — intake imports it and its own contract test checks the order — so drift in
+    either the members or their order is the defect."""
+    import lab.core.archimate as archimate
+    assert archimate.CHANGES == ("new", "updated", "consumed", "removed")
+    assert archimate.CAPABILITY_STATUSES == ("new", "updated", "consumed", "missing")
