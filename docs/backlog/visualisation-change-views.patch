@@ -0,0 +1,35 @@
+"""The ONE impact vocabulary and colour scale, shared by element views and the capability heatmaps.
+
+User decision 24 Oct 2026. An element in a proposal is `new`, `updated`, `consumed` (exists and is used
+unchanged) or `removed`; a capability in a map is `new`, `updated`, `consumed` or `missing` (required
+and nothing provides it). One scale, so an EA reading an as-is/to-be view and a capability heatmap side
+by side reads the same colour as the same thing:
+
+  green  new        amber  consumed / updated (updated a darker shade on element views)
+  red    missing    grey   removed (also drawn dashed)
+
+The heatmap colours are the CAFÉ ones they always were (`lab.core.usecase.views.common` imports them
+from here); element views add only what a capability never needs — `removed`, and a shade that tells
+`updated` from `consumed` where a heatmap uses a tag instead.
+"""
+from __future__ import annotations
+
+__all__ = ["CHANGES", "CAPABILITY_STATUSES", "FILL", "EDGE", "ELEMENT_FILL", "AS_IS", "TO_BE"]
+
+#: What a proposal does to an element (`changes`, beside the spec). A SHARED CONTRACT — intake imports
+#: it — so the members AND their order are pinned by a test.
+CHANGES: tuple[str, ...] = ("new", "updated", "consumed", "removed")
+#: What a proposal means for a capability (the envelope's `references`).
+CAPABILITY_STATUSES: tuple[str, ...] = ("new", "updated", "consumed", "missing")
+
+#: Fill and edge per status — the CAFÉ heatmap RAG mapping, plus `removed`.
+FILL = {"new": "#bfe6c6", "consumed": "#ffd98c", "updated": "#ffd98c", "missing": "#f5b1b1",
+        "removed": "#e0e0e0"}
+EDGE = {"new": "#1e7b34", "consumed": "#a86b00", "updated": "#a86b00", "missing": "#b3261e",
+        "removed": "#8a8a8a"}
+#: Element views: the same scale, with `updated` a darker amber so it is told apart without a tag.
+ELEMENT_FILL = {**FILL, "updated": "#f5b94a"}
+
+#: Which elements each change view holds.
+AS_IS = frozenset({"consumed", "updated", "removed"})
+TO_BE = frozenset({"consumed", "updated", "new"})
