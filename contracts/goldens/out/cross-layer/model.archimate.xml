<name xml:lang="en">Golden: cross-layer with interfaces</name>
<elements>
<element identifier="id-patient" xsi:type="BusinessActor"><name xml:lang="en">Patient</name><documentation xml:lang="en">[Business layer · active structure — BusinessActor] Organisational entity capable of performing behaviour.</documentation></element>
<element identifier="id-pharmacist" xsi:type="BusinessRole"><name xml:lang="en">Pharmacist</name><documentation xml:lang="en">[Business layer · active structure — BusinessRole] Responsibility for performing specific behaviour, to which an actor is assigned.</documentation></element>
<element identifier="id-dispense" xsi:type="BusinessProcess"><name xml:lang="en">Dispense medication</name><documentation xml:lang="en">[Business layer · behaviour structure — BusinessProcess] Sequence of behaviours achieving a specific result (has a trigger and an outcome).</documentation></element>
<element identifier="id-dispensing-svc" xsi:type="BusinessService"><name xml:lang="en">Dispensing service</name><documentation xml:lang="en">[Business layer · behaviour structure — BusinessService] Explicitly defined behaviour exposed to the environment, named as the consumer's outcome.</documentation></element>
<element identifier="id-portal" xsi:type="ApplicationComponent"><name xml:lang="en">Patient portal</name><documentation xml:lang="en">[Application layer · active structure — ApplicationComponent] Encapsulation of application functionality; deployable unit.</documentation></element>
<element identifier="id-portal-ui" xsi:type="ApplicationInterface"><name xml:lang="en">Portal UI</name><documentation xml:lang="en">[Application layer · active structure — ApplicationInterface] API / UI / protocol endpoint: point of access where an application service is made available.</documentation></element>
<element identifier="id-rx-svc" xsi:type="ApplicationService"><name xml:lang="en">Prescription service</name><documentation xml:lang="en">[Application layer · behaviour structure — ApplicationService] Explicitly defined application behaviour exposed to consumers (noun phrase for an outcome).</documentation></element>
<element identifier="id-rx-fn" xsi:type="ApplicationFunction"><name xml:lang="en">Manage prescriptions</name><documentation xml:lang="en">[Application layer · behaviour structure — ApplicationFunction] Automated behaviour performed by a component — the functional decomposition unit (verb + object).</documentation></element>
<element identifier="id-rx" xsi:type="DataObject"><name xml:lang="en">Prescription</name><documentation xml:lang="en">[Application layer · passive structure — DataObject] Data structured for automated processing.</documentation></element>
<element identifier="id-app-node" xsi:type="Node"><name xml:lang="en">Application server</name><documentation xml:lang="en">[Technology layer · active structure — Node] Computational or physical resource hosting/executing other technology elements.</documentation></element>
<element identifier="id-db" xsi:type="SystemSoftware"><name xml:lang="en">Database</name><documentation xml:lang="en">[Technology layer · active structure — SystemSoftware] Software environment for specific types of components/objects deployed on it.</documentation></element>
<element identifier="id-goal" xsi:type="Goal"><name xml:lang="en">Safer dispensing</name><documentation xml:lang="en">[Motivation layer · behaviour structure — Goal] High-level statement of intent or desired end state.</documentation></element>
</elements>
