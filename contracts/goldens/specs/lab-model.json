      "name": "Automated Business Process",
      "doc": "Pilot processes run as Agent Framework workflows"
    },
    {
      "id": "comp-gw",
      "type": "ApplicationComponent",
      "name": "LiteLLM Proxy",
      "doc": "Governance plane: /v1, /mcp, A2A; virtual keys, budgets, rate limits, tool ACLs"
    },
    {
      "id": "if-v1",
      "type": "ApplicationInterface",
      "name": "/v1 (OpenAI)"
    },
    {
      "id": "if-mcp",
      "type": "ApplicationInterface",
