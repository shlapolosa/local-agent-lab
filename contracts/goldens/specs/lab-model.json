{
  "name": "Local Enterprise-Agentic Prototyping Platform",
  "id": "lab-platform",
  "elements": [
    {
      "id": "driver-azure",
      "type": "Driver",
      "name": "Azure-first enterprise strategy"
    },
    {
      "id": "goal-parity",
      "type": "Goal",
      "name": "Pattern parity with Azure at zero licence cost",
      "doc": "Every prototype agent authenticates, egresses through a gateway, is metered, PII-scanned and traced"
    },
    {
      "id": "principle-gw",
      "type": "Principle",
      "name": "Single gateway for all egress"
    },
    {
      "id": "req-gov",
      "type": "Requirement",
      "name": "All traffic authenticated, metered, traced"
    },
    {
      "id": "req-pii",
      "type": "Requirement",
      "name": "No unredacted PII crosses the egress boundary"
    },
    {
      "id": "cap-apa",
      "type": "Capability",
      "name": "Agentic Process Automation"
    },
    {
      "id": "coa-cloud",
      "type": "CourseOfAction",
      "name": "Cloud-first inference",
      "doc": "No local models; 7B-class local inference out of scope on 8 GB"
    },
    {
      "id": "res-lab",
      "type": "Resource",
      "name": "M1 MacBook prototyping lab"
    },
    {
      "id": "actor-ea",
      "type": "BusinessActor",
      "name": "DOH Enterprise Architect"
    },
    {
      "id": "svc-auto",
      "type": "BusinessService",
      "name": "Business Process Automation"
    },
    {
