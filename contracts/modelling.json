{
  "$defs": {
    "change": {
      "description": "new = to be built; updated = existing, changed by this solution; consumed = existing, used as is; removed = existing, retired by an input (never inferred from absence).",
      "enum": [
        "new",
        "updated",
        "consumed",
        "removed"
      ]
    },
    "location": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "figure": {
          "type": [
            "integer",
            "string"
          ]
        },
        "page": {
          "type": [
            "integer",
            "string"
          ]
        },
        "paragraph": {
          "type": [
            "integer",
            "string"
          ]
        },
        "shape": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "open_question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable across rebuilds of the same content.",
          "pattern": "^oq-[0-9a-f]{10}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "raised",
            "no-provenance",
            "malformed-provenance",
            "orphan-provenance",
            "unknown-source",
            "quote-not-found",
            "location-mismatch",
            "unverifiable",
            "orphan-reference",
            "malformed-reference",
            "review-orphaned",
            "malformed-review",
            "invalid-id",
            "name-collision"
          ]
        },
        "provenance": {
          "description": "The entry the question is about, when there is one.",
          "type": "object"
        },
        "refs": {
          "additionalProperties": false,
          "properties": {
            "elements": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "relations": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "elements",
            "relations"
          ],
          "type": "object"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "refs"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/location"
        },
        "quote": {
          "description": "Verbatim words from the source, checked against the cited paragraph.",
          "minLength": 1,
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "location",
        "quote"
      ],
      "type": "object"
    },
    "provenance_by_id": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/provenance"
        },
        "type": "array"
      },
      "type": "object"
    },
    "ref_capabilities": {
      "additionalProperties": false,
      "description": "Capability-map matches: which capability each element touches.",
      "properties": {
        "capability_id": {
          "description": "The map's own id, e.g. KNW.11 (technology) or B1.1.2 (business).",
          "minLength": 1,
          "type": "string"
        },
        "confidence": {
          "description": "How sure the match is, in the matcher's own words.",
          "type": "string"
        },
        "element_id": {
          "description": "The model element this is about. Empty only when status=missing.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "level": {
          "type": [
            "integer",
            "string"
          ]
        },
        "map": {
          "description": "The capability map's artifact id in the reference corpus.",
          "minLength": 1,
          "type": "string"
        },
        "map_version": {
          "description": "The pinned version the match was made against.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "required": [
        "element_id",
        "map",
        "capability_id",
        "status"
      ],
      "type": "object"
    },
    "ref_concepts": {
      "additionalProperties": false,
      "description": "The element linked to a fabric vocabulary concept.",
      "properties": {
        "concept_iri": {
          "description": "Absent for a candidate the vocabulary does not hold yet.",
          "type": "string"
        },
        "confidence": {
          "description": "How sure the match is, in the matcher's own words.",
          "type": "string"
        },
        "element_id": {
          "description": "The model element this reference is about.",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "scheme": {
          "type": "string"
        },
        "status": {
          "enum": [
            "linked",
            "candidate"
          ]
        }
      },
      "required": [
        "element_id",
        "label",
        "status"
      ],
      "type": "object"
    },
    "ref_realisations": {
      "additionalProperties": false,
      "description": "Realisation-map entries: what realises each matched capability.",
      "properties": {
        "capability_id": {
          "minLength": 1,
          "type": "string"
        },
        "catalogue_id": {
          "description": "The reference-architecture catalogue id (cmp-...) when the realiser is a catalogue component.",
          "type": "string"
        },
        "confidence": {
          "description": "How sure the match is, in the matcher's own words.",
          "type": "string"
        },
        "element_id": {
          "description": "The model element this reference is about.",
          "type": "string"
        },
        "realised_by": {
          "description": "What realises the capability: a product, platform or existing system.",
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "required": [
        "element_id",
        "capability_id",
        "realised_by",
        "status"
      ],
      "type": "object"
    },
    "ref_repository": {
      "additionalProperties": false,
      "description": "The element resolved against the EA repository (through the EA port's ea_search). Drives create-vs-update at import and the impact view.",
      "properties": {
        "candidates": {
          "description": "The other repository objects considered, for the architect to pick from.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "confidence": {
          "description": "How sure the match is, in the matcher's own words.",
          "type": "string"
        },
        "element_id": {
          "description": "The model element this reference is about.",
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/change"
        },
        "repository_class": {
          "description": "The repository's own class name for the object.",
          "type": "string"
        },
        "repository_id": {
          "description": "Absent when match=new.",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "match"
      ],
      "type": "object"
    },
    "review_decision": {
      "additionalProperties": false,
      "description": "One architect decision at the modelling gate (D8), per element or relation.",
      "properties": {
        "actor": {
          "description": "The signed-in human. Blank is refused.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "correction": {
          "description": "With state=corrected: the fields that change.",
          "type": "object"
        },
        "item_id": {
          "minLength": 1,
          "type": "string"
        },
        "item_kind": {
          "enum": [
            "element",
            "relation"
          ]
        },
        "note": {
          "type": "string"
        },
        "state": {
          "enum": [
            "accepted",
            "corrected",
            "rejected"
          ]
        }
      },
      "required": [
        "item_kind",
        "item_id",
        "state",
        "actor"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "description": "Other names for the same artifact.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ref": {
          "description": "Opaque key provenance.source_ref points at.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ref",
        "name",
        "media_type",
        "aliases"
      ],
      "type": "object"
    },
    "status": {
      "description": "The change vocabulary plus missing = needed, and nothing realises it.",
      "enum": [
        "new",
        "updated",
        "consumed",
        "removed",
        "missing"
      ]
    }
  },
  "$id": "urn:lab:contracts:modelling:1.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What modelling emits: the FR-11 engine spec UNCHANGED under `spec`, with provenance, sources, references, change status, renames, reviews, open questions and refused relations beside it (ADR docs/decisions/2026-10-24-architecture-modelling.md). Generated from lab.core.modelling; never edit by hand.",
  "properties": {
    "changes": {
      "additionalProperties": {
        "$ref": "#/$defs/change"
      },
      "description": "Per element, its change relative to the EA repository, for impact views (as-is = consumed, updated, removed; to-be = consumed, updated, new). The lab's visualisation does not read it yet.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "type": "object"
    },
    "contract_version": {
      "const": "1.2.0"
    },
    "dropped": {
      "description": "Relations proposed but refused (illegal by the matrix, an undeclared or ambiguous endpoint), each with its reason.",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "gaps": {
      "description": "Joins a mapper could not make.",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "open_questions": {
      "items": {
        "$ref": "#/$defs/open_question"
      },
      "type": "array"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "elements": {
          "$ref": "#/$defs/provenance_by_id"
        },
        "relations": {
          "$ref": "#/$defs/provenance_by_id"
        }
      },
      "required": [
        "elements",
        "relations"
      ],
      "type": "object"
    },
    "references": {
      "additionalProperties": false,
      "description": "What each model element is in other registers.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/ref_capabilities"
          },
          "type": "array"
        },
        "concepts": {
          "items": {
            "$ref": "#/$defs/ref_concepts"
          },
          "type": "array"
        },
        "realisations": {
          "items": {
            "$ref": "#/$defs/ref_realisations"
          },
          "type": "array"
        },
        "repository": {
          "items": {
            "$ref": "#/$defs/ref_repository"
          },
          "type": "array"
        }
      },
      "required": [
        "capabilities",
        "realisations",
        "repository",
        "concepts"
      ],
      "type": "object"
    },
    "renamed_from": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Element id -> the ids it had in earlier runs, declared only on evidence (same provenance location or the same repository id).",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "type": "object"
    },
    "reviews": {
      "description": "Architect decisions at the modelling gate, carried across re-runs: kept on an id that still exists, moved across a rename (an element's, or a relation endpoint's), and raised as `review-orphaned` when the id is gone.",
      "items": {
        "$ref": "#/$defs/review_decision"
      },
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/source"
      },
      "type": "array"
    },
    "spec": {
      "$ref": "urn:lab:contracts:archimate-spec:1.0.0"
    }
  },
  "required": [
    "contract_version",
    "spec",
    "sources",
    "provenance",
    "references",
    "changes",
    "renamed_from",
    "reviews",
    "open_questions",
    "dropped",
    "gaps"
  ],
  "title": "Architecture modelling envelope",
  "type": "object",
  "version": "1.2.0",
  "x-id-prefixes": {
    "ac-": "ApplicationComponent",
    "af-": "ApplicationFunction",
    "ba-": "BusinessActor",
    "bb-": "ApplicationComponent (a building block)",
    "bf-": "BusinessFunction",
    "bo-": "BusinessObject",
    "bp-": "BusinessProcess",
    "cap-": "Capability",
    "con-": "Constraint",
    "dlv-": "Deliverable",
    "drv-": "Driver",
    "fam-": "Grouping (a CAFÉ family)",
    "goal-": "Goal",
    "node-": "Node",
    "out-": "Outcome",
    "req-": "Requirement",
    "stk-": "Stakeholder",
    "svc-": "ApplicationService",
    "usecase": "Grouping, the use-case model root",
    "wp-": "WorkPackage",
    "zone-": "Grouping (a CAFÉ zone)"
  },
  "x-id-rule": "Every element and relation id matches [A-Za-z0-9_-]+ (an IRI local name). An element id is a prefix for its type plus a slug of its name, so a re-run that keeps the name keeps the id. The prefix is x-id-prefixes' for the type, otherwise the type's own name in kebab case (SystemSoftware -> 'system-software-'). A name with nothing to slug (e.g. wholly Arabic) gets 'h' plus a hash of the name. A rename is a new id, declared in `renamed_from` when modelling can show it is the same thing. A relation id is 'r-' + md5(src|type|tgt)[:10].",
  "x-stability": {
    "changes": "draft",
    "envelope": "draft",
    "open_question": "draft",
    "provenance": "draft",
    "references": "draft",
    "reviews": "draft"
  }
}
